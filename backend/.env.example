# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ─────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/teamforge?retryWrites=true&w=majority&appName=Cluster0

# ── Auth ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRE=7d

# ── CORS ─────────────────────────────────────────
CLIENT_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# ── AI (Groq) — get free key at console.groq.com ─
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI (Gemini) — get free key at aistudio.google.com ─
# Gemini 1.5 Flash: 15 RPM, 1M tokens/day, no credit card needed
# Set this as PRIMARY — more reliable than Groq for JSON tasks
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudinary — free at cloudinary.com ──────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth — console.cloud.google.com ──────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
